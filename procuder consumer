#include <stdio.h>
#include <stdlib.h>

#define MAX 5

int buffer[MAX];
int x = 0;

// Semaphores
int mutex = 1;
int full = 0;
int empty = MAX;

// Wait function
void wait(int *s) { (*s)--; }

// Signal function
void signal(int *s) { (*s)++; }

// Producer
void producer() {
    int item;

    if (empty == 0) {
        printf("Buffer is Full\n");
        return;
    }

    wait(&mutex);
    wait(&empty);

    printf("Enter item to produce: ");
    scanf("%d", &item);

    buffer[x++] = item;

    printf("Produced item: %d\n", item);

    signal(&full);
    signal(&mutex);
}

// Consumer
void consumer() {
    int item;

    if (full == 0) {
        printf("Buffer is Empty\n");
        return;
    }

    wait(&mutex);
    wait(&full);

    item = buffer[--x];

    printf("Consumed item: %d\n", item);

    signal(&empty);
    signal(&mutex);
}

// Display
void display() {
    if (x == 0) {
        printf("Buffer is Empty\n");
        return;
    }

    printf("Buffer: ");
    for (int i = 0; i < x; i++)
        printf("%d ", buffer[i]);

    printf("\n");
}

int main() {
    int choice;

    while (1) {
        printf("\n1. Produce\n2. Consume\n3. Display\n4. Exit\n");
        scanf("%d", &choice);

        switch (choice) {
            case 1: producer(); break;
            case 2: consumer(); break;
            case 3: display(); break;
            case 4: exit(0);
            default: printf("Invalid choice\n");
        }
    }

    return 0;
}
