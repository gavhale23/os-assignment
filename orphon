//Orphan Process 

#include<stdio.h>
#include<stdlib.h>
#include<unistd.h>

int main()
{
    pid_t pid;

    pid = fork();

    if(pid > 0)
    {
        printf("Parent Process (PID=%d) exiting\n", getpid());
        exit(0);
    }
    else
    {
        sleep(5);   // child runs after parent exit

        printf("Child Process\n");
        printf("Child PID = %d\n", getpid());
        printf("New Parent PID = %d\n", getppid());
    }

    return 0;
}




