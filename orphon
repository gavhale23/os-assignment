//Zombie Process 

#include<stdio.h>
#include<stdlib.h>
#include<unistd.h>

int main()
{
    pid_t pid;

    pid = fork();

    if(pid > 0)
    {
        // Parent sleeping, not calling wait()
        sleep(10);

        printf("Parent Process\n");
    }
    else
    {
        printf("Child Process\n");
        printf("Child exiting...\n");

        exit(0);  // child exits immediately
    }

    return 0;
}
