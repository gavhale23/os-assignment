#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>

int main()
{
    pid_t pid1, pid2;

    // ---------- ZOMBIE PROCESS ----------
    pid1 = fork();

    if (pid1 > 0)
    {
        // Parent does NOT call wait()
        printf("\n=== Zombie Process Demo ===\n");
        printf("Parent PID = %d\n", getpid());

        sleep(10); // child becomes zombie during this time

        printf("Parent exiting after sleep...\n");
    }
    else if (pid1 == 0)
    {
        printf("Child Process (Zombie)\n");
        printf("Child PID = %d\n", getpid());

        printf("Child exiting...\n");
        exit(0); // child exits immediately
    }

    // ---------- ORPHAN PROCESS ----------
    pid2 = fork();

    if (pid2 > 0)
    {
        printf("\n=== Orphan Process Demo ===\n");
        printf("Parent PID = %d exiting...\n", getpid());

        exit(0); // parent exits first
    }
    else if (pid2 == 0)
    {
        sleep(5); // child runs after parent exits

        printf("Orphan Child Process\n");
        printf("Child PID = %d\n", getpid());
        printf("New Parent PID = %d\n", getppid());
    }

    return 0;
}
